#include <stdbool.h>

bool isValid(char* s) {
    char stack[10004];
    int top = -1;

    for (int i = 0; s[i] != '\0'; i++) {
        char c = s[i];

        if (c == '(' || c == '{' || c == '[') {
            // Push opening bracket
            stack[++top] = c;
        } 
        else {
            // No opening bracket to match
            if (top == -1) {
                return false;
            }

            char open = stack[top--];

            if ((c == ')' && open != '(') ||
                (c == '}' && open != '{') ||
                (c == ']' && open != '[')) {
                return false;
            }
        }
    }

    // Valid only if no opening brackets remain
    return top == -1;
}
