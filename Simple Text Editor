#include <stdio.h>
#include <stdlib.h>
#include <string.h>
int main() {
    int Q;
    scanf("%d", &Q);
    char *s = malloc(1);
    s[0] = '\0';
    char **history = malloc((Q + 1) * sizeof(char *));
    int top = 0;
    for (int i = 0; i < Q; i++) {
        int type;
        scanf("%d", &type);
        if (type == 1) {
            char w[100005];
            scanf("%s", w);
            history[top++] = strdup(s);
            int new_len = strlen(s) + strlen(w);
            s = realloc(s, new_len + 1);
            strcat(s, w);
        } else if (type == 2) {
            int k;
            scanf("%d", &k);
            history[top++] = strdup(s);
            int len = strlen(s);
            s[len - k] = '\0';
        } else if (type == 3) {
            int k;
            scanf("%d", &k);
            printf("%c\n", s[k - 1]);
        } else if (type == 4) {
            if (top > 0) {
                free(s);
                s = history[--top];
            }
        }
    }
    free(s);
    while (top > 0) {
        free(history[--top]);
    }
    free(history);
    return 0;
}
