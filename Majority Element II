#include <stdlib.h>

/**
 * Note: The returned array must be bmalloced, assume caller calls free().
 */
int* majorityElement(int* nums, int numsSize, int* returnSize) {
    // 1. Initialize candidates and counts
    int candidate1 = 0, candidate2 = 0;
    int count1 = 0, count2 = 0;

    // 2. First Pass: Find the top two potential majority candidates
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == candidate1) {
            count1++;
        } else if (nums[i] == candidate2) {
            count2++;
        } else if (count1 == 0) {
            candidate1 = nums[i];
            count1 = 1;
        } else if (count2 == 0) {
            candidate2 = nums[i];
            count2 = 1;
        } else {
            count1--;
            count2--;
        }
    }

    // 3. Second Pass: Verify candidate counts
    count1 = 0;
    count2 = 0;
    for (int i = 0; i < numsSize; i++) {
        if (nums[i] == candidate1) {
            count1++;
        } else if (nums[i] == candidate2) {
            count2++;
        }
    }

    // 4. Allocate dynamic memory for result array (max size is 2)
    int* result = (int*)malloc(2 * sizeof(int));
    *returnSize = 0;

    if (count1 > numsSize / 3) {
        result[(*returnSize)++] = candidate1;
    }
    // Ensure we don't accidentally count a single unique element twice
    if (count2 > numsSize / 3 && candidate1 != candidate2) {
        result[(*returnSize)++] = candidate2;
    }

    return result;
}
