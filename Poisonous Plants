#include <stdio.h>
#include <stdlib.h>
#define MAX(a, b) ((a) > (b) ? (a) : (b))
typedef struct {
    int level;
    int days;
} Plant;

int poisonousPlants(int p_count, int* p) {
    Plant* stack = (Plant*)malloc(p_count * sizeof(Plant));
    int top = -1;
    int max_days = 0;
    for (int i = 0; i < p_count; i++) {
        int days = 0;
        while (top >= 0 && stack[top].level >= p[i]) {
            days = MAX(days, stack[top].days);
            top--;
        }
        if (top == -1) {
            days = 0;
        } else {
            days = days + 1;
        }
        max_days = MAX(max_days, days);
        top++;
        stack[top].level = p[i];
        stack[top].days = days;
    }
    free(stack);
    return max_days;
}

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;
    int* p = (int*)malloc(n * sizeof(int));
    for (int i = 0; i < n; i++) {
        if (scanf("%d", &p[i]) != 1) {
            free(p);
            return 0;
        }
    }
    int result = poisonousPlants(n, p);
    printf("%d\n", result);
    free(p);
    return 0;
}
