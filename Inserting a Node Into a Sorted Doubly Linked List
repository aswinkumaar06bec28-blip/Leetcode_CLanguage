 *
 * DoublyLinkedListNode {
 *     int data;
 *     DoublyLinkedListNode* next;
 *     DoublyLinkedListNode* prev;
 * };
 *
 */

DoublyLinkedListNode* sortedInsert(DoublyLinkedListNode* llist, int data) {
     // 1. Create the new doubly linked list node
    DoublyLinkedListNode* new_node = create_doubly_linked_list_node(data);

    // 2. Case 1: The list is empty
    if (llist == NULL) {
        return new_node;
    }

    // 3. Case 2: The new node belongs at the very front (new head)
    if (data <= llist->data) {
        new_node->next = llist;
        llist->prev = new_node;
        return new_node; // Return new_node as it is the revised head
    }

    // 4. Case 3: The new node belongs somewhere in the middle or at the very end
    DoublyLinkedListNode* current = llist;
    
    // Advance current through the list until we find the right insertion slot
    while (current->next != NULL && current->next->data < data) {
        current = current->next;
    }

    // Connect new_node's structural pointers to its surrounding neighbors
    new_node->next = current->next;
    new_node->prev = current;

    // Adjust the next neighbor's backward pointer if we aren't inserting at the tail
    if (current->next != NULL) {
        current->next->prev = new_node;
    }
    
    // Adjust current node's forward pointer to link to the new node
    current->next = new_node;

    // 5. Return the original head of the list
    return llist;
}

