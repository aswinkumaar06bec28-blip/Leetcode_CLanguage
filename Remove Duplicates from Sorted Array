#include <stdio.h>

int removeDuplicates(int* nums, int numsSize) {
    // Handle empty array case
    if (numsSize == 0) {
        return 0;
    }
    
    int k = 1;         
    for (int i = 1; i < numsSize; i++) {
        // Compare current element with the last kept unique element
        if (nums[i] != nums[k - 1]) {
            nums[k] = nums[i]; 
            k++;
        }
    }
    
    return k;
}
